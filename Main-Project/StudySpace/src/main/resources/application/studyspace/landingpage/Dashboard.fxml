<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<VBox xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="application.studyspace.controllers.landingpage.DashboardController"
      stylesheets="@../styles/LoginandRegisterStylesheet.css,
                   @../styles/landingpage-override.css,
                   @../styles/dashboard-override.css"
      styleClass="root"
      spacing="24"
      fillWidth="true">

    <!-- HEADER -->
    <HBox styleClass="header-card"
          alignment="CENTER_LEFT"
          spacing="8">
        <ImageView fitHeight="32" preserveRatio="true">
            <Image url="@images/logos/smallLogo.png"/>
        </ImageView>
        <Label text="Planify Dashboard" styleClass="header-title"/>
        <Pane HBox.hgrow="ALWAYS"/>
    </HBox>

    <HBox spacing="24" VBox.vgrow="ALWAYS" fillHeight="true" alignment="TOP_LEFT">
        <!-- SIDEBAR -->
        <VBox styleClass="login-card"
              minWidth="240" maxWidth="240" prefWidth="240"
              VBox.vgrow="ALWAYS"
              spacing="20" alignment="TOP_LEFT">
            <Label text="Planify Menu" styleClass="login-title"/>

            <ToggleButton styleClass="sidebar-button"
                          toggleGroup="$navGroup"
                          onAction="#handleSidebarCalendar">
                <graphic>
                    <FontIcon iconLiteral="far-calendar-alt"/>
                </graphic>
                <text>Calendar</text>
            </ToggleButton>
            <ToggleButton styleClass="sidebar-button"
                          toggleGroup="$navGroup"
                          selected="true"
                          onAction="#handleSidebarDashboard">
                <graphic>
                    <FontIcon iconLiteral="fas-chart-bar"/>
                </graphic>
                <text>Dashboard</text>
            </ToggleButton>
            <ToggleButton styleClass="sidebar-button"
                          toggleGroup="$navGroup"
                          onAction="#handleSidebarSettings">
                <graphic>
                    <FontIcon iconLiteral="fas-cog"/>
                </graphic>
                <text>Settings</text>
            </ToggleButton>

            <Region VBox.vgrow="ALWAYS"/>
            <Button fx:id="logoutButton"
                    onAction="#handleExit"
                    styleClass="sidebar-logout">
                <graphic>
                    <FontIcon iconLiteral="fas-times" />
                </graphic>
                <text>Logout</text>
            </Button>
        </VBox>

        <!-- Main content  -->
        <GridPane fx:id="dashboardGrid"
                  hgap="28" vgap="28"
                  alignment="CENTER"
                  VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS"
                  GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">

            <columnConstraints>
                <ColumnConstraints percentWidth="50" halignment="CENTER" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="50" halignment="CENTER" hgrow="ALWAYS"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints percentHeight="50" valignment="CENTER" vgrow="ALWAYS"/>
                <RowConstraints percentHeight="50" valignment="CENTER" vgrow="ALWAYS"/>
            </rowConstraints>
            <!-- Past sessions card -->
            <VBox fx:id="pastSessionsBox"
                  styleClass="card-box"
                  alignment="TOP_CENTER"
                  spacing="14"
                  GridPane.rowIndex="0" GridPane.columnIndex="0"
                  GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
                <Label text="Last Sessions"
                       styleClass="main-title"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;" />
            </VBox>

            <!-- Next EXAM -->
            <VBox styleClass="card-box"
                  alignment="TOP_CENTER"
                  spacing="18"
                  GridPane.rowIndex="0" GridPane.columnIndex="1"
                  GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">

                <Label text="Time left until next exam" styleClass="main-title"
                       style="-fx-font-size: 26px; -fx-font-weight: bold;" alignment="CENTER" />

                <VBox alignment="CENTER" spacing="6" VBox.vgrow="ALWAYS">
                    <!-- Move the subject label inside here, just above the circle, with minimal spacing -->
                    <Label fx:id="nextExamSubjectLabel"
                           text="GERMAN EXAM"
                           style="-fx-font-size: 22px; -fx-font-weight: bold;" />
                    <StackPane alignment="CENTER">
                        <Circle radius="120" style="-fx-stroke: #111; -fx-stroke-width: 12; -fx-fill: transparent;"/>
                        <VBox alignment="CENTER" spacing="3">
                            <Label fx:id="nextExamDaysLabel"
                                   text="7D"
                                   style="-fx-font-size: 36px; -fx-font-weight: bold;"/>
                            <Label fx:id="nextExamHoursLabel"
                                   text="18H"
                                   style="-fx-font-size: 36px; -fx-font-weight: bold;"/>
                            <Label fx:id="nextExamMinutesLabel"
                                   text="25M"
                                   style="-fx-font-size: 36px; -fx-font-weight: bold;"/>
                        </VBox>
                    </StackPane>
                </VBox>
            </VBox>

            <!-- Time studied & Streak Card -->
            <VBox styleClass="card-box" alignment="CENTER" spacing="0"
                  GridPane.rowIndex="1" GridPane.columnIndex="0"
                  GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">

                <HBox alignment="CENTER" spacing="0" prefWidth="546" prefHeight="260">
                    <!-- Time Studied Today -->
                    <VBox alignment="CENTER" spacing="13" prefWidth="273">
                        <Label text="Time studied&#10;today"
                               styleClass="main-title"
                               style="-fx-font-size: 31px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI', Arial, sans-serif;"
                               wrapText="true" textAlignment="CENTER" alignment="CENTER"/>
                        <Label fx:id="timeStudiedLabel"
                               text="3h"
                               style="-fx-font-size: 78px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI', Arial, sans-serif;"/>
                    </VBox>

                    <!-- Vertical Divider -->
                    <Rectangle width="4" height="200" fill="#222" arcWidth="2" arcHeight="2" />

                    <!-- Study Streak -->
                    <VBox alignment="CENTER" spacing="13" prefWidth="273">
                        <Label text="Study&#10;Streak"
                               styleClass="main-title"
                               style="-fx-font-size: 31px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI', Arial, sans-serif;"
                               wrapText="true" textAlignment="CENTER" alignment="CENTER"/>
                        <HBox alignment="CENTER" spacing="10">
                            <Label fx:id="studyStreakLabel"
                                   text="3"
                                   style="-fx-font-size: 78px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI', Arial, sans-serif;"/>
                            <ImageView fx:id="fireImage"
                                       fitHeight="91" preserveRatio="true"
                                       style="-fx-effect: dropshadow(gaussian, black, 4, 0.25, 0, 1.5);">
                                <Image url="@images/logos/firemoji.png"/>
                            </ImageView>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Progress per Exam Card -->
            <VBox styleClass="card-box"
                  alignment="TOP_CENTER"
                  spacing="18"
                  GridPane.rowIndex="1" GridPane.columnIndex="1"
                  GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
                <Label text="Progress per Exam" styleClass="main-title"/>
                <GridPane hgap="90" vgap="60" alignment="CENTER">
                    <!-- Row 0 -->
                    <VBox alignment="CENTER" GridPane.rowIndex="0" GridPane.columnIndex="0">
                        <Label fx:id="progressTitle1" text="Exam 1" styleClass="field-label"/>
                        <StackPane alignment="CENTER">
                            <Circle fx:id="progressBg1" radius="50" style="-fx-stroke: #ddd; -fx-stroke-width: 10; -fx-fill: transparent;"/>
                            <Circle fx:id="progressRing1" radius="50" style="-fx-stroke: #111; -fx-stroke-width: 10; -fx-fill: transparent;"/>
                            <Label fx:id="progressLabel1" text="50%" style="-fx-font-size: 25px; -fx-font-weight: bold;"/>
                        </StackPane>
                    </VBox>
                    <VBox alignment="CENTER" GridPane.rowIndex="0" GridPane.columnIndex="1">
                        <Label fx:id="progressTitle2" text="Exam 2" styleClass="field-label"/>
                        <StackPane alignment="CENTER">
                            <Circle fx:id="progressBg2" radius="50" style="-fx-stroke: #ddd; -fx-stroke-width: 10; -fx-fill: transparent;"/>
                            <Circle fx:id="progressRing2" radius="50" style="-fx-stroke: #111; -fx-stroke-width: 10; -fx-fill: transparent;"/>
                            <Label fx:id="progressLabel2" text="50%" style="-fx-font-size: 25px; -fx-font-weight: bold;"/>
                        </StackPane>
                    </VBox>
                    <!-- Row 1 -->
                    <VBox alignment="CENTER" GridPane.rowIndex="1" GridPane.columnIndex="0">
                        <Label fx:id="progressTitle3" text="Exam 3" styleClass="field-label"/>
                        <StackPane alignment="CENTER">
                            <Circle fx:id="progressBg3" radius="50" style="-fx-stroke: #ddd; -fx-stroke-width: 10; -fx-fill: transparent;"/>
                            <Circle fx:id="progressRing3" radius="50" style="-fx-stroke: #111; -fx-stroke-width: 10; -fx-fill: transparent;"/>
                            <Label fx:id="progressLabel3" text="50%" style="-fx-font-size: 25px; -fx-font-weight: bold;"/>
                        </StackPane>
                    </VBox>
                    <VBox alignment="CENTER" GridPane.rowIndex="1" GridPane.columnIndex="1">
                        <Label fx:id="progressTitle4" text="Exam 4" styleClass="field-label"/>
                        <StackPane alignment="CENTER">
                            <Circle fx:id="progressBg4" radius="50" style="-fx-stroke: #ddd; -fx-stroke-width: 10; -fx-fill: transparent;"/>
                            <Circle fx:id="progressRing4" radius="50" style="-fx-stroke: #111; -fx-stroke-width: 10; -fx-fill: transparent;"/>
                            <Label fx:id="progressLabel4" text="50%" style="-fx-font-size: 25px; -fx-font-weight: bold;"/>
                        </StackPane>
                    </VBox>
                </GridPane>
            </VBox>
        </GridPane>
    </HBox>

    <fx:define>
        <ToggleGroup fx:id="navGroup"/>
    </fx:define>
</VBox>
